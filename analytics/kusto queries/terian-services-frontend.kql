pageViews
| extend PacificTime = datetime_utc_to_local(timestamp, 'US/Pacific')
| project PacificTime, name, url, duration, client_City, client_CountryOrRegion, client_Browser, client_OS
| order by PacificTime asc

pageViews
| summarize visits=count() by client_CountryOrRegion, client_City, client_Browser
| order by visits desc