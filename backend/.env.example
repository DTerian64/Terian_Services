# ── Azure OpenAI ────────────────────────────────────────────────────────────
# Required.  Bare resource URL — do NOT append /openai/v1.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=replace-me
# Deployment name in your Azure OpenAI resource (not the model family name).
# Terraform provisions this deployment as "gpt-5-nano".
AZURE_OPENAI_MODEL=gpt-5-nano
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call /api/*.
# Leave unset to use the built-in defaults (terian-services.com + localhost).
TERIAN_ALLOWED_ORIGINS=https://terian-services.com,https://www.terian-services.com,http://localhost:5173

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

APPINSIGHTS_RESOURCE_ID=/subscriptions/4ddf12bb-5397-445f-bcaa-df4c7d3dfdca/resourceGroups/rg_award_nomination_sandbox/providers/microsoft.insights/components/appi-award-api-sandbox

# ── Zoho SMTP ──────────────────────────────────────────────────────────────
# Paid organization/domain mailbox: use smtppro.zoho.com with STARTTLS on 587.
SMTP_USER=sales@terian-services.com
SMTP_PASSWORD=replace-with-a-zoho-app-password
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
CONTACT_NOTIFY_EMAIL=sales@terian-services.com
